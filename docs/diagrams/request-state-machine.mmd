stateDiagram-v2

    %% ======================================
    %% STATE DEFINITIONS
    %% ======================================

    state "Initial"          as INITIAL
    state "Pending"          as PENDING
    state "In Progress"      as IN_PROGRESS
    state "Requester Review" as REQUESTER_REVIEW
    state "Operations"       as OPERATIONS
    state "Done"             as DONE

    %% ======================================
    %% INITIALIZATION
    %% ======================================

    [*] --> INITIAL

    INITIAL --> PENDING : Submit Request

    %% ======================================
    %% PENDING
    %% ======================================

    PENDING --> IN_PROGRESS : Committee Accepts
    PENDING --> REQUESTER_REVIEW : Committee Declines

    %% ======================================
    %% IN_PROGRESS
    %% ======================================

    IN_PROGRESS --> PENDING : Committee requests help
    IN_PROGRESS --> REQUESTER_REVIEW : Submit for Review

    %% ======================================
    %% REQUESTER_REVIEW
    %% ======================================

    REQUESTER_REVIEW --> PENDING : Reassign to some Committee
    REQUESTER_REVIEW --> OPERATIONS : Submission Approved

    %% ======================================
    %% OPERATIONS
    %% ======================================

    OPERATIONS --> REQUESTER_REVIEW : Decline Submission
    OPERATIONS --> DONE : Approved Request

    %% ======================================
    %% DONE
    %% ======================================

    DONE --> [*]

    %% ======================================
    %% STYLING
    %% ======================================

    classDef initial fill:#F1EFE8,stroke:#5F5E5A,color:#2C2C2A
    classDef pending fill:#FAEEDA,stroke:#854F0B,color:#412402
    classDef active  fill:#E6F1FB,stroke:#185FA5,color:#042C53
    classDef review  fill:#EEEDFE,stroke:#534AB7,color:#26215C
    classDef ops     fill:#E1F5EE,stroke:#0F6E56,color:#04342C
    classDef done    fill:#EAF3DE,stroke:#3B6D11,color:#173404

    class INITIAL initial
    class PENDING pending
    class IN_PROGRESS active
    class REQUESTER_REVIEW review
    class OPERATIONS ops
    class DONE done
