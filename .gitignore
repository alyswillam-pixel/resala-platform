# ===========================
# Resala-System Monorepo
# Single consolidated .gitignore
# ===========================


# ===== PYTHON / DJANGO (backend/) =====

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff
staticfiles/
resala_platform/media/

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Celery
celerybeat-schedule
celerybeat.pid

# Virtual environments
.venv/
venv/
ENV/

# Rope project settings
.ropeproject

# mkdocs
/site

# mypy
.mypy_cache/

# pytype
.pytype/

# IPython / Jupyter
.ipython/
.ipynb_checkpoints/


# ===== NODE.JS / FRONTEND (frontend/ & docs/) =====

# Dependencies
node_modules/
jspm_packages/
bower_components/

# Build output
dist-ssr/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
lib-cov/
.nyc_output/

# Caches
.npm
.eslintcache
.node_repl_history
.lock-wscript

# Compiled binary addons
build/Release

# TypeScript v1 declaration files
typings/

# Output of 'npm pack'
*.tgz

# Yarn
.yarn-integrity


# ===== ENVIRONMENT / SECRETS =====

.env
.env.*

# Production secrets must NEVER be committed
backend/.envs/.production/

# Local dev defaults (.envs/.local/) ARE safe to commit


# ===== DOCKER =====

docker-compose.override.yml


